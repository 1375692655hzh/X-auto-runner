# xar-agent 实例配置模板
# 拷贝到 /etc/xar/instance.yaml 并填写；权限必须 600；缺任何必填项服务拒绝启动
# 本文件不含 cookie——cookie 独立存放于 cookie_file 指向的文件（同权限 600）

proxy:                      # 必填：静态住宅代理（与指纹永久绑定，规范 §三）
  scheme: "http"            # http | socks5
  host: ""
  port: 0
  username: ""
  password: ""

account:                    # 必填
  handle: ""                # 不含 @，如 WCixot
  cookie_file: "/etc/xar/cookies.json"   # {auth_token, ct0, twid, guest_id}

persona:                    # P4 起必填
  card: "/etc/xar/persona-card.md"

llm:                        # 2026-11-10 换链后结构：所有职能统一走 default 供应商链，
  default:                  # 不再分 draft/reply/comment/report/analysis/review/decision 通道
    model: ""              # GLM Coding Plan：glm-5.3-flash @ open.bigmodel.cn/api/coding/paas/v4
    api_key: ""
    base_url: ""
    temperature: 1
    # 跨供应商按序互备（2026-11-05 机制）：主key耗尽/失效时落到下家，10分钟熔断自动跳过。
    # 生产当前：GLM → DeepSeek 官方(deepseek-chat)。
    # 运营授权边界（2026-11-10）：仅四家 API——GLM 自动化 / DeepSeek（搜索key兼文本兜底）/
    # 阿里图像 qwen-image-3.0-pro / 阿里决策 decision-model-preview(systemone)。
    # 不得新增供应商（含历史遗留的火山）除非运营明确授权。
    fallback_providers:
    - {model: "", api_key: "", base_url: ""}
  # 判定器专用通道（2026-11-10 晚运营拍板）：ARK deepseek-v4.1-flash 头 + DeepSeek 官方兜底。
  # 背景：glm-5.3-flash 思考模式 ~7tok/s 拖垮判定热路径；范围仅判定器（tickers.py），
  # 其余职能仍走 default 链。缺省本段时 conf 自动回落 default。
  tickers:
    model: ""                # ARK: deepseek-v4.1-flash @ ark.cn-beijing.volces.com/api/plan/v3
    api_key: ""
    base_url: ""
    fallback_providers:
    - {model: "", api_key: "", base_url: ""}   # DeepSeek 官方 deepseek-chat
    fallback_to_default: true  # 双兜底全挂时最后回落 default 链（罕见）
  # decision 通道：dormant 资产保留（2026-11-10 运营裁定：配置应该在，用不用按设计决定）。
  # 阿里 decision-model-preview 走 systemone 专用协议（POST {base_url}/systemone，
  # body 为 state+questions，输出 choice/noul/score 结构化判定），不支持 chat/completions。
  # llm.conf() 见 protocol!=chat 即跳过并回落 default——chat 消费者不会空撞该端点。
  # 启用路径：写 systemone 协议适配层后由适配层直读本段配置。
  decision:
    protocol: systemone
    model: decision-model-preview
    api_key: ""
    base_url: https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

im:                         # QQ 官方机器人 WebSocket/REST（不是 NapCat）
  qq:
    enabled: false
    app_id: ""              # QQ 开放平台机器人 AppID
    app_secret: ""          # 仅存在本文件（600），禁止写入仓库
    commander_whitelist: [] # 允许下指令的 QQ openid（安全关键）
    commander_claim: false  # 白名单为空时是否允许首个发信人认领；生产建议 false

news_auto:
  mode: review              # review|auto；auto 仅资讯原创，其他动作不受影响
  structured_gate: shadow   # shadow|enforce；先用真实采纳数据对账再转正
  max_age_hours: {资讯: 6, 精品文章: 24}  # auto 发布前素材年龄硬上限

ops:
  daily_token_alert: 2000000  # 今日 prompt+completion token 超阈时 QQ 告警；0=关闭
  effects:
    enabled: true            # 只读 FxTwitter 效果采样，不产生 X 写动作

runtime:
  active_window: ["06:30", "24:00"]
  # 任务量对齐 x-auto-tool（2026-11-09 运营拍板开跑；此前 post95/reply15/like30/comment10 为引擎保险丝）
  budget_24h: {post: 10, reply: 20, like: 30, comment: 60, follow: 180, unfollow: 0}
  writes:
    enabled: false            # P3 总开关：真实写动作（默认关；QQ 票据就绪后开）
  approval:
    default: required         # 每种动作审批模式 required|none（none 只能由用户改）
    reply: none               # 2026-11-09 开跑：互动全自动（reply/comment/follow 免审，帽见 budget_24h）
    comment: none
    follow: none
